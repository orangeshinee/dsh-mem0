# pnpm: auto-confirm the node_modules purge when the installed layout does not
# match the current pnpm (e.g. after a pnpm upgrade). Without this, pnpm asks
# interactively and aborts with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY in
# non-TTY / CI environments, breaking `pnpm build` there.
confirmModulesPurge=false
